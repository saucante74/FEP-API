# Copy this file to `.env` and adjust values for your local environment.
# `.env` is git-ignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Spring
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker

# ---------------------------------------------------------------------------
# Database (MySQL) — used both by the mysql container and by the api service
# ---------------------------------------------------------------------------
MYSQLDB_DATABASE=fep
MYSQLDB_ROOT_PASSWORD=changeme

# Inside the docker network the api container reaches MySQL via the "mysql"
# service name. If you run the app outside Docker (./gradlew bootRun) while
# only the DB runs in Docker, use jdbc:mysql://localhost:3307/fep instead.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/fep
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=changeme
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop

# ---------------------------------------------------------------------------
# JWT — generate a real secret with: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-256-bit-hex-secret
JWT_EXPIRATION=3600000

# ---------------------------------------------------------------------------
# Mail (Mailhog in dev) — use the "mailhog" service name inside the
# docker network, or localhost if running the app outside Docker.
# ---------------------------------------------------------------------------
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=noreply@fep.com
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:4200

# ---------------------------------------------------------------------------
# Logging (avoid DEBUG in production: it can leak sensitive data in logs)
# ---------------------------------------------------------------------------
LOG_LEVEL_ROOT=info
LOG_LEVEL_SPRING=info
LOG_LEVEL_HIBERNATE=info
LOG_LEVEL_SPRING_SECURITY=info
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
